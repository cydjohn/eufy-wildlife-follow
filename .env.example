# Copy to .env (git-ignored) and fill in. Never commit .env.

# eufy-security-ws login. Use a separate Eufy account that the camera is shared with.
EUFY_USERNAME=
EUFY_PASSWORD=
EUFY_COUNTRY=US

# Serial of the S340 to watch: run `inventory --show-serials` and copy it here.
WILDLIFE_DEVICE_SERIAL=
# 1 only after model-install, preflight and a supervised trial have passed.
WILDLIFE_ENABLED=0
# observe = wake on events, stream, detect; listen = log events only, never stream.
WILDLIFE_MODE=observe
# 1 turns the camera toward animals (closed-loop pan steps). Off by default.
WILDLIFE_FOLLOW=0

# Optional tuning (defaults shown).
# WILDLIFE_SESSION_SECONDS=30
# WILDLIFE_INITIAL_TARGET_SECONDS=12
# WILDLIFE_TARGET_LOSS_SECONDS=8
# WILDLIFE_NIGHT_HOLD_SECONDS=130
# WILDLIFE_COOLDOWN_SECONDS=30
# WILDLIFE_CONFIDENCE=0.1
# WILDLIFE_MIN_BATTERY=25
# WILDLIFE_MAX_STEPS=16
# WILDLIFE_MAX_NET_STEPS=5
# Pan step measured with `ptz-probe` (fraction of image width). Built in for the S340;
# required before any other camera (for example the E42) will follow.
# WILDLIFE_PAN_STEP=
